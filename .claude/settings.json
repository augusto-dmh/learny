{
  "includeCoAuthoredBy": false,
  "env": {
    "LEARNY_TEST_DATABASE_URL": "postgresql+psycopg://learny:learny@localhost:5432/learny_test"
  },
  "permissions": {
    "allow": [
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(gh issue:*)",
      "Bash(gh api repos/augusto-dmh/learny:*)",
      "Bash(gh api -X DELETE repos/augusto-dmh/learny:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s http://127.0.0.1:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(docker info)",
      "Bash(docker ps:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose restart:*)",
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git pull)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(alembic:*)"
    ]
  }
}
