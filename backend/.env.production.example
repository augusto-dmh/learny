# Learny backend — production env template (AD-042/AD-043).
#
# Split into ./secrets/*.env files referenced by docker-compose.prod.yml:
#   - ./secrets/api.env     → the `api` service
#   - ./secrets/worker.env  → the `worker` service
#   - ./secrets/db.env      → the `db` service (POSTGRES_PASSWORD)
#   - ./secrets/minio.env   → the `minio` service (MINIO_ROOT_USER/PASSWORD)
#   - ./secrets/backup.env  → the `backup` service (schedules, retention, offsite,
#                             heartbeat, and point-in-time recovery)
# Copy the relevant lines into those files with REAL values; never commit them
# (the `secrets/` directory is git-ignored). Non-secret prod config
# (LEARNY_ENVIRONMENT, LEARNY_SESSION_COOKIE_SECURE, LEARNY_LOG_FORMAT) is set
# inline in the compose overlay and does not belong here.

# --- ./secrets/db.env ---
POSTGRES_PASSWORD=change-me-strong-db-password

# --- ./secrets/minio.env ---
MINIO_ROOT_USER=change-me-storage-access-key
MINIO_ROOT_PASSWORD=change-me-strong-storage-secret

# --- ./secrets/api.env  and  ./secrets/worker.env ---
# Database URL (embeds the DB password above).
LEARNY_DATABASE_URL=postgresql+psycopg://learny:change-me-strong-db-password@db:5432/learny
# S3-compatible object storage credentials (match minio.env, or a real provider).
LEARNY_STORAGE_ACCESS_KEY=change-me-storage-access-key
LEARNY_STORAGE_SECRET_KEY=change-me-strong-storage-secret

# --- ./secrets/api.env only ---
# Trusted browser origin(s) for the CSRF Origin/Referer check (AD-007). Must be
# the public HTTPS origin the app is served from, comma-separated if several.
LEARNY_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# Uvicorn worker processes (tune to CPU; defaults to 2 in the compose command).
LEARNY_API_WORKERS=2
# Per-format upload byte caps (optional; shown at their defaults). PDFs are larger
# than EPUBs on average, so the PDF cap is higher.
# LEARNY_EPUB_MAX_BYTES=52428800
# LEARNY_PDF_MAX_BYTES=104857600
# Scanned-PDF OCR (optional; shown at their defaults) — the PDF worker retries a
# textless PDF once with OCR. Disable only if the deployed image lacks the baked
# OCR models; the language list must match the models baked in the image.
# LEARNY_PDF_OCR_ENABLED=true
# LEARNY_PDF_OCR_LANGS=en,pt
# Notes & second-brain (optional; shown at its default) — max Markdown body length
# per note, enforced at validation before any write (RFC-003 Cycle E, ADR-0026).
# LEARNY_NOTES_MAX_BODY_CHARS=100000

# --- ./secrets/backup.env ---
# Consumed by the `backup` service (RFC-003 Cycle A). It also reads POSTGRES_PASSWORD
# from db.env and MINIO_ROOT_USER/PASSWORD from minio.env (reused, not duplicated
# here). Every value below is optional and shown at its default.
# Nightly dump schedule (crond format).
LEARNY_BACKUP_CRON=30 3 * * *
# Days of local dumps to keep (and offsite dumps, when configured); older ones prune.
LEARNY_BACKUP_KEEP_DAYS=14
# Source object bucket mirrored offsite (matches LEARNY_STORAGE_BUCKET).
LEARNY_BACKUP_SOURCE_BUCKET=learny-sources
# Offsite S3-compatible target. Leave ALL FOUR blank to keep backups local-only;
# set all four to also copy each dump offsite and mirror the source bucket there.
LEARNY_BACKUP_REMOTE_ENDPOINT=
LEARNY_BACKUP_REMOTE_ACCESS_KEY=
LEARNY_BACKUP_REMOTE_SECRET_KEY=
LEARNY_BACKUP_REMOTE_BUCKET=
# Optional dead-man's-switch URL, pinged only after a fully successful run.
LEARNY_BACKUP_HEARTBEAT_URL=

# --- ./secrets/backup.env — point-in-time recovery (RFC-005 Cycle E) ---
# Two artifact families make point-in-time recovery work, and their retention is
# COUPLED: WAL segments are useless without a physical base to replay onto, so a
# segment is pruned only when it is past its window AND no longer required by the
# oldest retained base backup. Never prune the archive by age by hand — doing so
# breaks the replay chain silently, and the break only shows up during a restore.
# Every value below is optional and shown at its default.
#
# Weekly physical base backup (crond format). Keep it clear of LEARNY_BACKUP_CRON:
# the base backup shares the nightly dump's lock, so an overlapping run is skipped.
LEARNY_BASEBACKUP_CRON=0 2 * * 0
# How often archived WAL segments are copied offsite. This interval IS the offsite
# recovery point for WAL — segments only leave the host when this job runs.
LEARNY_WAL_SHIP_CRON=*/15 * * * *
# Age floor for pruning WAL segments. It can only ever WITHHOLD a segment from
# pruning; it is never sufficient on its own to delete one (see the coupling above).
LEARNY_WAL_KEEP_DAYS=14
# Where each artifact family lives inside the backup sidecar. The archive directory
# is the volume the db archives into, shared with this service.
LEARNY_BASEBACKUP_DIR=/backups/base
LEARNY_WAL_ARCHIVE_DIR=/wal_archive
# Single-run guard for WAL shipping. Deliberately NOT the dump's lock: shipping
# competes with nothing, and sharing would let one nightly dump stretch the
# offsite recovery point above.
LEARNY_WAL_LOCK=/tmp/learny-wal.lock
# Base backups and WAL segments go offsite through the SAME four
# LEARNY_BACKUP_REMOTE_* variables above — there is no separate offsite target.

# --- /opt/learny/.env (compose interpolation, not a secrets file) ---
# How long the database may hold a partially filled WAL segment before closing it,
# in seconds. It bounds how far the archive can lag an idle database, so it is the
# floor under the recovery point. Changing archive_mode itself requires a database
# restart (see docs/ops/backups.md); this value does not.
LEARNY_WAL_ARCHIVE_TIMEOUT=900
