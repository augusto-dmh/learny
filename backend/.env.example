# Learny backend environment contract (NFR-SEC-003).
# Copy to .env for local runs; never commit real secrets.

LEARNY_ENVIRONMENT=local
LEARNY_DEBUG=false

# PostgreSQL (SQLAlchemy + psycopg v3 URL)
LEARNY_DATABASE_URL=postgresql+psycopg://learny:learny@localhost:5432/learny

# Session cookie attributes (NFR-SEC-002)
LEARNY_SESSION_COOKIE_NAME=learny_session
LEARNY_SESSION_COOKIE_SECURE=true
LEARNY_SESSION_COOKIE_SAMESITE=lax
LEARNY_SESSION_COOKIE_PATH=/

# Object storage (S3-compatible; MinIO locally, AD-011)
LEARNY_STORAGE_ENDPOINT=http://localhost:9000
LEARNY_STORAGE_ACCESS_KEY=learny
LEARNY_STORAGE_SECRET_KEY=learny-dev-secret
LEARNY_STORAGE_BUCKET=learny-sources
LEARNY_STORAGE_REGION=us-east-1

# Upload limits (AD-009) — per-format byte caps (50 MiB EPUB, 100 MiB PDF). The
# upload handler reads at most max(caps)+1 and rejects oversize files per format.
LEARNY_EPUB_MAX_BYTES=52428800
LEARNY_PDF_MAX_BYTES=104857600

# Scanned-PDF OCR (ADR-0025) — a textless PDF is retried once with OCR before
# failing. Disable to reproduce the OCR-less behavior (e.g. an image without the
# baked OCR models); the language list must match the models baked in the image.
LEARNY_PDF_OCR_ENABLED=true
LEARNY_PDF_OCR_LANGS=en,pt

# Embeddings (ADR-0007/0019) — provider/model live only in the adapter.
# LEARNY_EMBEDDING_PROVIDER selects the adapter: "local" (default, deterministic
# and network-free — CI/tests need no key) or "openai". LEARNY_OPENAI_API_KEY is
# required only when the provider is "openai" (env-only secret; never committed).
# LEARNY_EMBEDDING_MODEL is the OpenAI model name (the deterministic adapter ignores
# it). LEARNY_EMBEDDING_DIM is the single vector width — sent to OpenAI as the
# dimensions param and matching the vector(1536) column.
LEARNY_EMBEDDING_DIM=1536
LEARNY_EMBEDDING_PROVIDER=local
LEARNY_OPENAI_API_KEY=
LEARNY_EMBEDDING_MODEL=text-embedding-3-large
LEARNY_EMBEDDING_BATCH_SIZE=128

# Generation provider (local = deterministic extractive, offline; anthropic = Claude).
# LEARNY_ANTHROPIC_API_KEY is required when the provider is anthropic (fails fast at
# startup otherwise). LEARNY_JUDGE_MODEL and LEARNY_EVAL_MAX_CASES only affect the
# offline evaluation harness / nightly judge run.
LEARNY_GENERATION_PROVIDER=local
LEARNY_ANTHROPIC_API_KEY=
LEARNY_GENERATION_MODEL=claude-sonnet-5
LEARNY_GENERATION_MAX_TOKENS=1024
LEARNY_JUDGE_MODEL=claude-haiku-4-5
LEARNY_EVAL_MAX_CASES=50

# Hybrid retrieval tuning (ADR-0006)
LEARNY_RETRIEVAL_SEMANTIC_LIMIT=50
LEARNY_RETRIEVAL_LEXICAL_LIMIT=50
LEARNY_RETRIEVAL_RRF_K=60
LEARNY_RETRIEVAL_TOP_K=10
LEARNY_RETRIEVAL_MAX_TOP_K=50
LEARNY_HNSW_EF_SEARCH=100

# Notes & second-brain (RFC-003 Cycle E; ADR-0026) — max Markdown body length per
# note, enforced at validation before any write.
LEARNY_NOTES_MAX_BODY_CHARS=100000

# App instrumentation (RFC-006 Cycle A) — timing collection is always on; only the
# dev-only surface that exposes it is gated, so LEARNY_DEV_INSTRUMENT_ENABLED stays
# false everywhere except local development (the production compose never sets it).
# The same flag decides whether responses carry the Server-Timing header, which is
# the only part of the instrument that leaves the process. A process running with
# LEARNY_ENVIRONMENT=production refuses both even if this flag arrives set, and logs
# a warning saying so.
# LEARNY_INSTRUMENT_CAPACITY is how many request samples and slow-query entries one
# process keeps before the oldest are dropped. A statement counts as slow at or above
# LEARNY_SLOW_QUERY_MS; zero or below deliberately captures every statement.
# LEARNY_SLOW_QUERY_STATEMENT_CHARS caps the captured statement text (SQL only —
# bound parameter values are never captured).
LEARNY_DEV_INSTRUMENT_ENABLED=false
LEARNY_INSTRUMENT_CAPACITY=500
LEARNY_SLOW_QUERY_MS=200
LEARNY_SLOW_QUERY_STATEMENT_CHARS=2000

# The page unit (RFC-006 Cycle B) — how many words make one page. An EPUB reflows,
# so this defines the page a reader can hold on to. Pages derive from the word
# counts already stored per section, so changing this re-pages every book with no
# migration and no re-ingestion. This is the only definition: the reader receives it
# on the chapter response and the study window serves pages resolved against it.
LEARNY_WORDS_PER_PAGE=275
